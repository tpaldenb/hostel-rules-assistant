# Copy to .env and fill in ONE key. Without a key the app runs in offline mode.

# Free options
GEMINI_API_KEY=
GROQ_API_KEY=

# Paid option
ANTHROPIC_API_KEY=

# auto picks the first provider with a key (Claude, Gemini, then Groq).
# Also: offline, claude, gemini, groq, ollama
ASSISTANT_MODE=auto

# Optional: use a different model on Gemini, Groq or Ollama
LLM_MODEL=
CLAUDE_MODEL=claude-opus-5-5
